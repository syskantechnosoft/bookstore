<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="03-insert-roles-v4" author="bookstore">
        <insert tableName="roles">
            <column name="name" value="ROLE_ADMIN"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_LIBRARIAN"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_USER"/>
        </insert>
    </changeSet>

    <!-- Verified BCrypt Hashes:
         admin -> Admin@123 ($2a$10$Uz8SVm.hWxmm4Z7t5j/bbezZ/.1Skwt2h8qa5BbGPiAg3VqWCO3Qy)
         librarian -> Librarian@123 ($2a$10$Rt7fu1NCw.lVUpT3ccyOKuePF5tG/ob0/a/p1M4NYw4NT9kgIoKrO)
         user -> User@123 ($2a$10$1ik0xxNSqC4SEA7zbTLVFeO4.PWKXaljyrdpt4eO7advVu.F3ivYi)
    -->
    <changeSet id="03-insert-users-v4" author="bookstore">
        <insert tableName="users">
            <column name="username" value="admin"/>
            <column name="email" value="admin@bookstore.com"/>
            <column name="password" value="$2a$10$Uz8SVm.hWxmm4Z7t5j/bbezZ/.1Skwt2h8qa5BbGPiAg3VqWCO3Qy"/>
            <column name="full_name" value="System Administrator"/>
        </insert>
        <insert tableName="users">
            <column name="username" value="librarian"/>
            <column name="email" value="librarian@bookstore.com"/>
            <column name="password" value="$2a$10$Rt7fu1NCw.lVUpT3ccyOKuePF5tG/ob0/a/p1M4NYw4NT9kgIoKrO"/>
            <column name="full_name" value="Chief Librarian"/>
        </insert>
        <insert tableName="users">
            <column name="username" value="user"/>
            <column name="email" value="user@bookstore.com"/>
            <column name="password" value="$2a$10$1ik0xxNSqC4SEA7zbTLVFeO4.PWKXaljyrdpt4eO7advVu.F3ivYi"/>
            <column name="full_name" value="Regular Reader"/>
        </insert>
    </changeSet>

    <changeSet id="03-insert-user-roles-v4" author="bookstore">
        <sql>
            INSERT INTO user_roles (user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.username = 'admin' AND r.name = 'ROLE_ADMIN';
            INSERT INTO user_roles (user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.username = 'librarian' AND r.name = 'ROLE_LIBRARIAN';
            INSERT INTO user_roles (user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.username = 'user' AND r.name = 'ROLE_USER';
        </sql>
    </changeSet>

    <changeSet id="03-sync-identity-sequences-v4" author="bookstore">
        <sql dbms="h2">
            ALTER TABLE users ALTER COLUMN id RESTART WITH 100;
            ALTER TABLE roles ALTER COLUMN id RESTART WITH 100;
            ALTER TABLE books ALTER COLUMN id RESTART WITH 500;
        </sql>
        <sql dbms="postgresql">
            SELECT setval(pg_get_serial_sequence('users', 'id'), coalesce(max(id), 1) + 100) FROM users;
            SELECT setval(pg_get_serial_sequence('roles', 'id'), coalesce(max(id), 1) + 100) FROM roles;
            SELECT setval(pg_get_serial_sequence('books', 'id'), coalesce(max(id), 1) + 500) FROM books;
        </sql>
        <sql dbms="mysql">
            ALTER TABLE users AUTO_INCREMENT = 100;
            ALTER TABLE roles AUTO_INCREMENT = 100;
            ALTER TABLE books AUTO_INCREMENT = 500;
        </sql>
    </changeSet>

</databaseChangeLog>
