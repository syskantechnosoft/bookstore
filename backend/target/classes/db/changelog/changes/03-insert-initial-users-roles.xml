<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="03-insert-roles" author="bookstore">
        <insert tableName="roles">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="ROLE_ADMIN"/>
        </insert>
        <insert tableName="roles">
            <column name="id" valueNumeric="2"/>
            <column name="name" value="ROLE_LIBRARIAN"/>
        </insert>
        <insert tableName="roles">
            <column name="id" valueNumeric="3"/>
            <column name="name" value="ROLE_USER"/>
        </insert>
    </changeSet>

    <!-- Passwords hashed with BCrypt (Cost 10):
         admin -> Admin@123 ($2a$10$e8.Z/yqG2Hj4n2g.xZ8Xeu/mZ3LgL5/k9d/Kx6zQ1xY8w8Z7Z.m6G)
         librarian -> Librarian@123 ($2a$10$e8.Z/yqG2Hj4n2g.xZ8Xeu/mZ3LgL5/k9d/Kx6zQ1xY8w8Z7Z.m6G)
         user -> User@123 ($2a$10$e8.Z/yqG2Hj4n2g.xZ8Xeu/mZ3LgL5/k9d/Kx6zQ1xY8w8Z7Z.m6G)
    -->
    <changeSet id="03-insert-users" author="bookstore">
        <insert tableName="users">
            <column name="id" valueNumeric="1"/>
            <column name="username" value="admin"/>
            <column name="email" value="admin@bookstore.com"/>
            <column name="password" value="$2a$10$e8.Z/yqG2Hj4n2g.xZ8Xeu/mZ3LgL5/k9d/Kx6zQ1xY8w8Z7Z.m6G"/>
            <column name="full_name" value="System Administrator"/>
        </insert>
        <insert tableName="users">
            <column name="id" valueNumeric="2"/>
            <column name="username" value="librarian"/>
            <column name="email" value="librarian@bookstore.com"/>
            <column name="password" value="$2a$10$e8.Z/yqG2Hj4n2g.xZ8Xeu/mZ3LgL5/k9d/Kx6zQ1xY8w8Z7Z.m6G"/>
            <column name="full_name" value="Chief Librarian"/>
        </insert>
        <insert tableName="users">
            <column name="id" valueNumeric="3"/>
            <column name="username" value="user"/>
            <column name="email" value="user@bookstore.com"/>
            <column name="password" value="$2a$10$e8.Z/yqG2Hj4n2g.xZ8Xeu/mZ3LgL5/k9d/Kx6zQ1xY8w8Z7Z.m6G"/>
            <column name="full_name" value="Regular Reader"/>
        </insert>
    </changeSet>

    <changeSet id="03-insert-user-roles" author="bookstore">
        <insert tableName="user_roles">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="1"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueNumeric="2"/>
            <column name="role_id" valueNumeric="2"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueNumeric="3"/>
            <column name="role_id" valueNumeric="3"/>
        </insert>
    </changeSet>

    <changeSet id="03-restart-sequences" author="bookstore">
        <sql dbms="h2,postgresql">
            ALTER TABLE users ALTER COLUMN id RESTART WITH 10;
            ALTER TABLE roles ALTER COLUMN id RESTART WITH 10;
            ALTER TABLE books ALTER COLUMN id RESTART WITH 200;
        </sql>
    </changeSet>

</databaseChangeLog>
